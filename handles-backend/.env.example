# Server
PORT=4000
NODE_ENV=production

# Frontend origin(s) allowed to call the authenticated API (comma separated).
# Include the Cloudflare Pages origin used by the live frontend.
FRONTEND_ORIGIN=https://mainhandles.pages.dev,https://daviddchucks-hash.github.io

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (from your Firebase service account JSON)
# IMPORTANT: paste the private key with \n literal newlines - the code converts them.
FIREBASE_PROJECT_ID=handles-82cc1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@handles-82cc1.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://handles-82cc1-default-rtdb.firebaseio.com

# Optional separate key used to encrypt webhook signing secrets at rest.
# If omitted, JWT_SECRET is used as the encryption key source.
WEBHOOK_ENCRYPTION_KEY=replace-with-another-long-random-string

# Per API-key request limit for /api/v1 (requests per rolling minute).
PUBLIC_API_RATE_LIMIT=120
# Webhook request timeout in milliseconds.
WEBHOOK_TIMEOUT_MS=10000

# Email notifications (Resend is called by the backend only).
# RESEND_API_KEY is optional for local development; without it, submissions
# still succeed and delivery failures are logged.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Handles
# URL users should open when they click "View submission in Handles".
DASHBOARD_URL=https://mainhandles.pages.dev
# Optional IANA timezone for email timestamps (defaults to UTC).
NOTIFICATION_TIME_ZONE=UTC