# Server
PORT=4000
NODE_ENV=production

# Frontend origin(s) allowed to call the authenticated API (comma separated).
# This should be your GitHub Pages URL.
FRONTEND_ORIGIN=https://daviddchucks-hash.github.io

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (from your Firebase service account JSON)
# IMPORTANT: paste the private key with \n literal newlines - the code converts them.
FIREBASE_PROJECT_ID=handles-82cc1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@handles-82cc1.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://handles-82cc1-default-rtdb.firebaseio.com
