PORT=3000
API_URL=https://new-handles.onrender.com
FRONTEND_ORIGIN=https://daviddchucks-hash.github.io/Handles
JWT_SECRET=replace-with-a-secure-random-secret
FIREBASE_DB_URL=https://your-project.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT should be the full JSON for a Firebase service account (stringified). On Render, set it as a secret env var.
# Example (do NOT commit real credentials):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}
